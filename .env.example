# 复制为 .env 后按需修改。默认值也可以直接启动。
APP_PORT=5290
MYSQL_ROOT_PASSWORD=mini_card_root_password
RABBITMQ_DEFAULT_USER=mini_card
RABBITMQ_DEFAULT_PASS=mini_card_mq_password
RABBITMQ_URL=amqp://mini_card:mini_card_mq_password@rabbitmq:5672/
ACTIVITY_AWARD_EXCHANGE=mini_xiyou.activity
ACTIVITY_AWARD_QUEUE=mini_xiyou.activity.awards
ACTIVITY_AWARD_ROUTING_KEY=activity.award
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_SECONDS=86400
